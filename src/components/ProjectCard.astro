---
interface Project {
	slug: string;
	title: string;
	category?: string;
	imgSrc: string;
	skills: string[];
	descripcion: string;
	lang?: string;
	repoURL?: string;
	demoURL?: string;
}
interface Props {
	project: Project;
	index: number;
}
const { project: p, index } = Astro.props;
---

<article class="card__inner" data-card>
	<div class="card__media">
		<div class="card__zoom" data-card-zoom>
			<img
				src={p.imgSrc}
				alt={`Tampilan proyek ${p.title}`}
				width="1600"
				height="1000"
				loading="lazy"
				decoding="async"
				data-card-img
			/>
		</div>
	</div>
	<div class="card__body">
		<div class="card__top">
			<span class="card__no mono">{String(index + 1).padStart(2, '0')}</span>
			{p.category && <span class="mono">{p.category}</span>}
		</div>
		<h3 class="card__title">
			<a href={`/proyek/${p.slug}/`} class="card__link">{p.title}</a>
		</h3>
		<p class="card__desc" lang={p.lang}>{p.descripcion}</p>
		<ul class="card__tags">
			{p.skills.map((s) => <li class="mono">{s}</li>)}
		</ul>
	</div>
	<i class="card__corner card__corner--tl" aria-hidden="true"></i>
	<i class="card__corner card__corner--br" aria-hidden="true"></i>
</article>

<style>
	.card__inner {
		position: relative;
		display: flex;
		flex: 1;
		flex-direction: column;
		background: var(--bg-raise);
		border: 1px solid var(--line);
		transition: border-color 0.4s;
	}
	.card__inner:hover {
		border-color: var(--line-strong);
	}
	.card__media {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-bottom: 1px solid var(--line);
		background: #000;
	}
	.card__zoom {
		width: 100%;
		height: 100%;
		will-change: transform;
	}
	.card__media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		filter: grayscale(0.9) contrast(1.05);
		transition: filter 0.6s;
		will-change: transform;
	}
	.card__inner:hover .card__media img {
		filter: none;
	}
	.card__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.9rem;
		padding: 1.25rem 1.25rem 1.5rem;
	}
	.card__top {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}
	.card__no {
		color: var(--accent);
	}
	.card__title {
		font-size: var(--fs-h3);
		font-weight: 560;
		line-height: 1;
		letter-spacing: -0.045em;
	}
	/* seluruh kartu menjadi area klik (tautan diregangkan lewat pseudo-element) */
	.card__link::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
	}
	.card__desc {
		display: -webkit-box;
		-webkit-line-clamp: 5;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--fg-dim);
	}
	.card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: auto 0 0;
		padding: 1rem 0 0;
		list-style: none;
	}
	.card__tags li {
		padding: 0.2rem 0.5rem;
		border: 1px solid var(--line-strong);
		font-size: 0.6875rem;
		color: var(--fg-dim);
	}

	/* siku garis yang memanjang saat hover */
	.card__corner {
		position: absolute;
		width: 0.9rem;
		height: 0.9rem;
		pointer-events: none;
		transition: width 0.6s var(--ease-out), height 0.6s var(--ease-out);
	}
	.card__corner--tl {
		top: -1px;
		left: -1px;
		border-top: 1px solid var(--accent);
		border-left: 1px solid var(--accent);
	}
	.card__corner--br {
		right: -1px;
		bottom: -1px;
		border-right: 1px solid var(--accent);
		border-bottom: 1px solid var(--accent);
	}
	.card__inner:hover .card__corner,
	.card__inner:focus-within .card__corner {
		width: 3.5rem;
		height: 3.5rem;
	}
</style>

---
/**
 * Garis horizontal selebar layar yang tergambar saat masuk viewport,
 * dengan tanda silang (+) di titik temu garis pemandu.
 */
---

<div class="rule" aria-hidden="true">
	<i class="rule__line" data-line></i>
	<div class="frame rule__marks">
		<b></b><b></b><b></b><b></b>
	</div>
</div>

<style>
	.rule {
		position: relative;
		height: 1px;
		width: 100%;
	}
	.rule__line {
		display: block;
		height: 1px;
		width: 100%;
		background: var(--line-strong);
		transform-origin: left;
	}
	.rule__marks {
		position: absolute;
		inset: 0;
		height: 0;
	}
	.rule__marks b {
		top: 0;
		width: 11px;
		height: 11px;
		margin: -5px 0 0 -5px;
		transition: opacity 0.6s 0.5s;
	}
	/* sisi kanan: geser ke kiri agar pusatnya tepat di garis */
	.rule__marks b:nth-child(4) {
		margin-right: -5px;
		margin-left: 0;
	}
	.rule__marks b::before,
	.rule__marks b::after {
		content: '';
		position: absolute;
		background: var(--fg-dim);
	}
	.rule__marks b::before {
		left: 5px;
		top: 0;
		width: 1px;
		height: 11px;
	}
	.rule__marks b::after {
		top: 5px;
		left: 0;
		height: 1px;
		width: 11px;
	}
	:global(.js) .rule__marks b {
		opacity: 0;
	}
	:global(.js) .rule.is-drawn .rule__marks b {
		opacity: 1;
	}
</style>

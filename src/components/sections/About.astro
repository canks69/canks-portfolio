---
import Rule from '../Rule.astro';
import SectionHead from '../SectionHead.astro';
import SocialLinks from '../SocialLinks.astro';

const facts = [
	{ k: 'Pengalaman', v: 'Sejak 2020' },
	{ k: 'Fokus', v: 'ERP & aplikasi enterprise' },
	{ k: 'Cakupan', v: 'Backend, Frontend, DevOps' },
];
---

<section id="about" class="about" data-about data-scene-stop="about">
	<Rule />
	<div class="wrap about__inner">
		<SectionHead no="01" label="Tentang" />

		<div class="about__grid">
			<figure class="about__figure" data-about-figure>
				<div class="about__photo" data-about-photo>
					<img
						src="/img/about-me.jpg"
						alt="Ilustrasi Canks bekerja di depan monitor berisi kode"
						width="1024"
						height="1536"
						loading="lazy"
						decoding="async"
						data-about-img
					/>
				</div>
				<figcaption class="mono">Fig. 02 — Ruang kerja</figcaption>
			</figure>

			<div class="about__body">
				<h2 class="display about__title" data-split>Tentang <span class="serif">Saya</span></h2>

				<p class="about__text lead" data-scrub>
					Saya pengembang web sejak 2020, dengan minat besar terhadap teknologi. Saya terus belajar dan
					mengikuti perkembangan terbaru untuk memahami cara perusahaan teknologi terkemuka menciptakan
					sistem yang andal. Dengan semangat tinggi, saya berusaha mengasah keterampilan dan berkontribusi
					pada proyek yang berdampak positif bagi pengguna
				</p>

				<dl class="about__facts" data-reveal-group>
					{
						facts.map((f) => (
							<div class="about__fact" data-reveal-item>
								<dt class="mono">{f.k}</dt>
								<dd>{f.v}</dd>
							</div>
						))
					}
				</dl>

				<div data-reveal>
					<SocialLinks />
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.about__inner {
		display: flex;
		flex-direction: column;
		gap: clamp(2.5rem, 6vw, 5rem);
		padding-block: 1.5rem clamp(5rem, 12vw, 10rem);
	}
	.about__grid {
		display: grid;
		gap: clamp(2.5rem, 6vw, 5rem);
	}

	.about__figure {
		margin: 0;
	}
	.about__photo {
		position: relative;
		overflow: hidden;
		aspect-ratio: 2 / 3;
		background: var(--bg-raise);
		border: 1px solid var(--line);
	}
	.about__photo img {
		display: block;
		width: 100%;
		height: 118%;
		object-fit: cover;
		filter: grayscale(0.85) contrast(1.05);
		will-change: transform;
	}
	.about__figure figcaption {
		margin-top: 1rem;
	}

	.about__body {
		display: flex;
		flex-direction: column;
		gap: clamp(1.75rem, 3vw, 2.75rem);
	}
	.about__title {
		margin: 0;
	}
	.about__title :global(.serif) {
		color: var(--accent);
	}
	.about__text {
		max-width: 34em;
		font-size: clamp(1.25rem, 1rem + 1.1vw, 1.875rem);
		line-height: 1.3;
		color: var(--fg);
	}

	.about__facts {
		display: grid;
		margin: 0;
		border-top: 1px solid var(--line-strong);
	}
	.about__fact {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block: 1rem;
		border-bottom: 1px solid var(--line);
	}
	.about__fact dd {
		margin: 0;
		text-align: right;
		font-size: 1.0625rem;
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	@media (min-width: 900px) {
		.about__grid {
			grid-template-columns: 5fr 7fr;
			align-items: start;
		}
		.about__figure {
			position: sticky;
			top: calc(var(--header-h) + 1.5rem);
		}
	}
</style>

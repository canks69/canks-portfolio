---
import Button from '../Button.astro';
import { FEATURES } from '../data/site.js';
const year = new Date().getFullYear();
---

<section class="hero" id="top" data-hero data-scene-stop="hero">
	<canvas class="hero__field" data-hero-field aria-hidden="true"></canvas>

	<div class="wrap hero__inner">
		<div class="hero__meta mono" data-intro data-hero-meta>
			<span>(Portofolio {year})</span>
			<span class="hero__meta-mid">Full Stack Developer</span>
			<span>Sejak 2020</span>
		</div>

		<div class="hero__mid">
			<p class="hero__lead lead" data-title>
				Full Stack Developer yang ahli dalam <em class="serif">teknologi modern.</em>
			</p>

			<figure class="hero__portrait" data-intro data-hero-portrait>
				<div class="hero__photo" data-hero-photo>
					<img
						src="/img/me-1x1.jpg"
						alt="Potret Canks"
						width="384"
						height="384"
						fetchpriority="high"
						decoding="async"
					/>
					<!-- relief 3D dari foto (Three.js); <img> tetap ada untuk SEO, aksesibilitas, dan perangkat tanpa WebGL -->
					{FEATURES.portraitRelief && <canvas class="hero__relief" data-hero-relief aria-hidden="true" />}
				</div>
				<svg class="hero__frame" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
					<path d="M0 0H100V100H0Z" data-hero-frame />
				</svg>
				<i class="hero__tick hero__tick--tl" aria-hidden="true"></i>
				<i class="hero__tick hero__tick--tr" aria-hidden="true"></i>
				<i class="hero__tick hero__tick--bl" aria-hidden="true"></i>
				<i class="hero__tick hero__tick--br" aria-hidden="true"></i>
				<figcaption class="mono">Fig. 01 — Canks</figcaption>
			</figure>
		</div>

		<h1 class="hero__word" data-intro data-hero-word>Canks</h1>

		<div class="hero__foot" data-intro data-hero-foot>
			<Button href="#about">Selengkapnya</Button>
			<span class="hero__cue mono" aria-hidden="true">
				Gulir
				<span class="hero__cue-line"><i data-hero-cue></i></span>
			</span>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		min-height: 100svh;
		padding-top: var(--header-h);
		overflow: hidden;
	}

	/* medan garis (canvas) di belakang konten */
	.hero__field {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		/* fade atas/bawah untuk garis latar ada di shader (heroScene.ts) agar teks & objek 3D tidak ikut memudar */
		pointer-events: none;
	}
	:global(.js) .hero__field {
		opacity: 0;
	}

	.hero__inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: space-between;
		gap: 2rem;
		padding-block: 1.25rem 1.75rem;
	}

	.hero__meta {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}
	.hero__meta-mid {
		display: none;
	}

	.hero__mid {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: end;
		gap: clamp(1.5rem, 4vw, 4rem);
		margin-block: auto;
		padding-block: 1rem;
	}
	.hero__lead {
		max-width: 15ch;
		font-size: clamp(2rem, 1.1rem + 3.4vw, 4.75rem);
		font-weight: 500;
		line-height: 1.02;
		letter-spacing: -0.045em;
		text-wrap: balance;
	}
	.hero__lead em {
		color: var(--accent);
		font-size: 1.08em;
	}

	/* ---- potret berbingkai garis ---- */
	.hero__portrait {
		position: relative;
		width: clamp(10rem, min(17vw, 29svh), 18rem);
		margin: 0;
	}
	.hero__photo {
		position: relative;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: var(--bg-raise);
	}
	.hero__photo img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 18%;
		filter: grayscale(1) contrast(1.08) brightness(0.92);
		will-change: transform, filter;
	}
	.hero__relief {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		pointer-events: none;
	}
	.hero__frame {
		position: absolute;
		inset: -0.9rem;
		width: calc(100% + 1.8rem);
		height: calc(100% + 1.8rem);
		overflow: visible;
		pointer-events: none;
	}
	.hero__frame path {
		fill: none;
		stroke: var(--line-strong);
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
	}
	.hero__tick {
		position: absolute;
		width: 11px;
		height: 11px;
		pointer-events: none;
	}
	.hero__tick::before,
	.hero__tick::after {
		content: '';
		position: absolute;
		background: var(--accent);
	}
	.hero__tick::before {
		left: 5px;
		top: 0;
		width: 1px;
		height: 11px;
	}
	.hero__tick::after {
		top: 5px;
		left: 0;
		width: 11px;
		height: 1px;
	}
	.hero__tick--tl {
		left: -0.9rem;
		top: -0.9rem;
		margin: -5px 0 0 -5px;
	}
	.hero__tick--tr {
		right: -0.9rem;
		top: -0.9rem;
		margin: -5px -5px 0 0;
	}
	.hero__tick--bl {
		left: -0.9rem;
		bottom: -0.9rem;
		margin: 0 0 -5px -5px;
	}
	.hero__tick--br {
		right: -0.9rem;
		bottom: -0.9rem;
		margin: 0 -5px -5px 0;
	}
	:global(.js) .hero__tick {
		opacity: 0;
	}
	.hero__portrait figcaption {
		margin-top: 1.5rem;
		text-align: right;
	}

	/* ---- kata besar ---- */
	/* teks 3D (Three.js) menggantikan tampilan <h1>; HTML-nya tetap ada untuk SEO & pembaca layar.
	   Atribut dipasang main.ts dan dihapus bila teks 3D tidak jadi dipakai (mis. tanpa WebGL). */
	.hero__word[data-three] {
		color: transparent;
	}
	.hero__word {
		margin: 0;
		font-size: min(21vw, 31svh);
		font-weight: 600;
		line-height: 0.8;
		letter-spacing: -0.07em;
		text-transform: uppercase;
		white-space: nowrap;
		margin-left: -0.04em;
	}

	.hero__foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.hero__cue {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
	}
	.hero__cue-line {
		position: relative;
		display: block;
		width: 4rem;
		height: 1px;
		background: var(--line-strong);
		overflow: hidden;
	}
	.hero__cue-line i {
		position: absolute;
		inset: 0;
		background: var(--accent);
		transform-origin: left;
	}

	@media (min-width: 768px) {
		.hero__meta-mid {
			display: inline;
		}
	}
	@media (max-width: 640px) {
		.hero__mid {
			grid-template-columns: 1fr;
			justify-items: start;
		}
		.hero__portrait {
			width: min(52vw, 12.5rem);
			order: -1;
		}
		.hero__lead {
			max-width: 12ch;
		}
		.hero__word {
			font-size: min(26vw, 31svh);
		}
	}
</style>

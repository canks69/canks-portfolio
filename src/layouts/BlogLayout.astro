---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageHead from '../components/PageHead.astro';
import { menuPage } from '../components/data/menuData';
import Layout from './Layout.astro';
import { SITE } from '../components/data/site.js';
import { blogPostingLd } from '../lib/seo';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, noindex } = Astro.props;
const url = new URL(Astro.url.pathname, SITE.url).toString();
---

<Layout
	title={`${title} | Canks`}
	description={description}
	type="article"
	noindex={noindex}
	jsonLd={blogPostingLd({ title, description, pubDate, updatedDate, url })}
>
	<Header origin={menuPage} />
	<main id="main">
		<article>
			<PageHead eyebrow="" back={{ href: '/blog', label: 'Semua tulisan' }} size="post">
				{title}
				<Fragment slot="lead">{description}</Fragment>
			</PageHead>
			<div class="wrap post-meta mono" data-intro data-page-meta>
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<>
							<span aria-hidden="true">/</span>
							<span>
								Diperbarui <FormattedDate date={updatedDate} />
							</span>
						</>
					)
				}
			</div>

			<div class="wrap post-body">
				<div class="prose" data-reveal>
					<slot />
				</div>
			</div>
		</article>
	</main>
	<Footer />
</Layout>

<style>
	.post-meta {
		display: flex;
		gap: 0.75rem;
		margin-bottom: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--line-strong);
	}
	.post-body {
		padding-bottom: clamp(5rem, 12vw, 9rem);
	}
	.prose {
		max-width: 44rem;
	}
</style>

---
import { getCollection } from 'astro:content';
import BlogRow from '../../components/BlogRow.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PageHead from '../../components/PageHead.astro';
import { menuPage } from '../../components/data/menuData';
import { FEATURES } from '../../components/data/site.js';
import Layout from '../../layouts/Layout.astro';

// blog disembunyikan (FEATURES.blog = false di src/components/data/site.js): arahkan ke beranda
if (!FEATURES.blog) return Astro.redirect('/');

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog | Canks" description="Tulisan dan catatan Canks seputar pengembangan web.">
	<Header origin={menuPage} />
	<main id="main">
		<PageHead eyebrow={`(${String(posts.length).padStart(2, '0')}) tulisan`}>Blog <span class="serif">Saya</span></PageHead>

		<section class="wrap posts">
			<ul class="posts__list" data-reveal-group>
				{
					posts.map((post, i) => (
						<BlogRow
							index={i}
							title={post.data.title}
							description={post.data.description}
							date={post.data.pubDate}
							href={`/blog/${post.id}/`}
						/>
					))
				}
			</ul>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.posts {
		min-height: 40svh;
		padding-bottom: clamp(5rem, 12vw, 9rem);
	}
	.posts__list {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--line-strong);
	}
</style>

---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { mainMenu } from '../components/data/menuData';
import { FEATURES } from '../components/data/site.js';
import About from '../components/sections/About.astro';
import Hero from '../components/sections/Hero.astro';
import Journal from '../components/sections/Journal.astro';
import Skills from '../components/sections/Skills.astro';
import Work from '../components/sections/Work.astro';
import Layout from '../layouts/Layout.astro';
import { homeLd } from '../lib/seo';
---

<Layout title="Canks | Fullstack Developer" jsonLd={homeLd()}>
	<Header origin={mainMenu} />
	<main id="main">
		<Hero />
		<About />
		<Skills />
		<Work />
		{FEATURES.blog && <Journal />}
	</main>
	<Footer />
</Layout>

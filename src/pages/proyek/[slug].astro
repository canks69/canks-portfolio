---
import Button from '../../components/Button.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PageHead from '../../components/PageHead.astro';
import Rule from '../../components/Rule.astro';
import { menuPage } from '../../components/data/menuData';
import { getProjects, neighbours, renderProjectBody } from '../../lib/projects';
import { skillKey } from '../../components/data/helpers.js';
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../components/data/site.js';
import { projectLd } from '../../lib/seo';

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project: p } = Astro.props;
const projects = await getProjects();
const { index, prev, next } = neighbours(projects, p.slug);
const Body = await renderProjectBody(p);
const no = String(index + 1).padStart(2, '0');
const total = String(projects.length).padStart(2, '0');

const facts = [
	p.fullTitle && { k: 'Nama lengkap', v: p.fullTitle },
	{ k: 'Kategori', v: p.category },
	p.role && { k: 'Peran', v: p.role },
	p.year && { k: 'Tahun', v: p.year },
].filter(Boolean) as { k: string; v: string }[];
---

<Layout
	title={`${p.title} | Canks`}
	description={p.descripcion.length > 160 ? `${p.descripcion.slice(0, 157).trimEnd()}…` : p.descripcion}
	image={p.imgSrc}
	imageAlt={`Tampilan proyek ${p.title}`}
	jsonLd={projectLd({
		title: p.title,
		fullTitle: p.fullTitle,
		description: p.descripcion,
		image: p.imgSrc,
		category: p.category,
		skills: p.skills,
		year: p.year,
		url: new URL(Astro.url.pathname, SITE.url).toString(),
		lang: p.lang,
	})}
>
	<Header origin={menuPage} />
	<main id="main">
		<PageHead eyebrow="" back={{ href: '/proyek/', label: 'Semua proyek' }} size="post">
			{p.title}
		</PageHead>

		<div class="wrap detail__meta mono" data-intro data-page-meta>
			<span>({no} / {total})</span>
			<span>{p.category}</span>
		</div>

		<section class="wrap detail">
			<figure class="detail__shot" data-reveal>
				<img src={p.imgSrc} alt={`Tampilan proyek ${p.title}`} width="1600" height="1000" decoding="async" />
				<i class="detail__corner detail__corner--tl" aria-hidden="true"></i>
				<i class="detail__corner detail__corner--br" aria-hidden="true"></i>
			</figure>

			<div class="detail__grid">
				<aside class="detail__side" data-reveal>
					<dl class="detail__facts">
						{
							facts.map((f) => (
								<div>
									<dt class="mono">{f.k}</dt>
									<dd>{f.v}</dd>
								</div>
							))
						}
						<div>
							<dt class="mono">Teknologi</dt>
							<dd>
								<ul class="detail__tags">
									{
										p.skills.map((s) => (
											<li>
												<a class="mono" href={`/keterampilan/#${skillKey(s)}`}>
													{s}
												</a>
											</li>
										))
									}
								</ul>
							</dd>
						</div>
					</dl>
					{
						(p.repoURL || p.demoURL) && (
							<div class="detail__links">
								{p.demoURL && (
									<Button href={p.demoURL} external>
										Lihat demo
									</Button>
								)}
								{p.repoURL && (
									<Button href={p.repoURL} variant="ghost" external>
										Repositori
									</Button>
								)}
							</div>
						)
					}
				</aside>

				<div class="detail__body">
					<p class="lead detail__desc" lang={p.lang} data-reveal>{p.descripcion}</p>
					{
						Body && (
							<div class="prose detail__prose" lang={p.lang} data-reveal>
								<Body />
							</div>
						)
					}
					{
						p.highlights.length > 0 && (
							<ul class="detail__highlights" data-reveal>
								{p.highlights.map((h: string) => (
									<li>{h}</li>
								))}
							</ul>
						)
					}
				</div>
			</div>
		</section>

		<nav class="pager" aria-label="Proyek lainnya">
			<Rule />
			<div class="wrap pager__inner">
				<a class="pager__link" href={`/proyek/${prev.slug}/`} data-row>
					<span class="mono">← Sebelumnya</span>
					<strong>{prev.title}</strong>
				</a>
				<a class="pager__link pager__link--next" href={`/proyek/${next.slug}/`} data-row>
					<span class="mono">Berikutnya →</span>
					<strong>{next.title}</strong>
				</a>
			</div>
		</nav>
	</main>
	<Footer />
</Layout>

<style>
	.detail__meta {
		display: flex;
		gap: 1.5rem;
		padding-bottom: 1.5rem;
	}
	.detail {
		display: flex;
		flex-direction: column;
		gap: clamp(2.5rem, 6vw, 5rem);
		padding-bottom: clamp(4rem, 9vw, 7rem);
	}
	.detail__shot {
		position: relative;
		margin: 0;
		background: #000;
		border: 1px solid var(--line);
	}
	.detail__shot img {
		display: block;
		width: 100%;
		height: auto;
		max-height: 80svh;
		object-fit: cover;
		object-position: top center;
	}
	.detail__corner {
		position: absolute;
		width: 2.25rem;
		height: 2.25rem;
		pointer-events: none;
	}
	.detail__corner--tl {
		top: -1px;
		left: -1px;
		border-top: 1px solid var(--accent);
		border-left: 1px solid var(--accent);
	}
	.detail__corner--br {
		right: -1px;
		bottom: -1px;
		border-right: 1px solid var(--accent);
		border-bottom: 1px solid var(--accent);
	}
	.detail__grid {
		display: grid;
		gap: 2.5rem;
	}
	.detail__facts {
		display: grid;
		margin: 0;
		border-top: 1px solid var(--line-strong);
	}
	.detail__facts > div {
		display: grid;
		gap: 0.5rem;
		padding-block: 1rem;
		border-bottom: 1px solid var(--line);
	}
	.detail__facts dd {
		margin: 0;
		font-size: 1.0625rem;
		font-weight: 500;
		letter-spacing: -0.02em;
	}
	.detail__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.detail__tags a {
		display: inline-block;
		padding: 0.25rem 0.55rem;
		border: 1px solid var(--line-strong);
		color: var(--fg-dim);
		transition: color 0.3s, background 0.3s, border-color 0.3s;
	}
	.detail__tags a:hover {
		background: var(--accent-fill);
		border-color: var(--accent-fill);
		color: var(--accent-ink);
	}
	.detail__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}
	.detail__desc {
		max-width: 32em;
		font-size: clamp(1.25rem, 1rem + 1.1vw, 1.875rem);
		line-height: 1.3;
		color: var(--fg);
	}
	.detail__prose {
		max-width: 44rem;
		margin-top: 3rem;
	}
	.detail__prose :global(h2:first-child) {
		margin-top: 0;
	}
	.detail__highlights {
		display: grid;
		gap: 0.75rem;
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
		color: var(--fg-dim);
	}
	.detail__highlights li {
		padding-left: 1.25rem;
		position: relative;
	}
	.detail__highlights li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.7em;
		width: 0.5rem;
		height: 1px;
		background: var(--accent);
	}

	/* ---- pager ---- */
	.pager__inner {
		display: grid;
		gap: 0;
	}
	.pager__link {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding-block: 2rem;
		border-bottom: 1px solid var(--line-strong);
		transition: color 0.3s;
	}
	.pager__link strong {
		font-size: var(--fs-h3);
		font-weight: 560;
		line-height: 1.05;
		letter-spacing: -0.045em;
	}
	.pager__link:hover {
		color: var(--accent);
	}
	@media (min-width: 900px) {
		.detail__grid {
			grid-template-columns: 4fr 8fr;
			align-items: start;
		}
		.detail__side {
			position: sticky;
			top: calc(var(--header-h) + 1.5rem);
		}
		.pager__inner {
			grid-template-columns: 1fr 1fr;
		}
		.pager__link--next {
			align-items: flex-end;
			text-align: right;
			border-left: 1px solid var(--line);
		}
	}
	.pager {
		margin-top: -1px;
	}
</style>
